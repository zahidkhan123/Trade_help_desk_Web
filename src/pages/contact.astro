---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="Contact Us & Request a Demo — Trade Help Desk"
  description="Get in touch with Trade Help Desk. Request a demo or ask about our property maintenance and field service management software. We usually reply within one business day."
>
  <PageHeader
    eyebrow="Contact"
    title="Get in touch"
    lead="Request a demo or ask us anything about Trade Help Desk. We usually reply within one business day."
  />

  <section class="section body">
    <div class="container grid">
      <form class="form" action={site.formspreeEndpoint} method="POST" data-contact-form novalidate>
        <div class="row">
          <div class="field">
            <label for="name">Name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label for="email">Work email <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
          </div>
        </div>
        <div class="field">
          <label for="company">Company <span class="opt">(optional)</span></label>
          <input id="company" name="company" type="text" autocomplete="organization" placeholder="Company name" />
        </div>
        <div class="field">
          <label for="message">Message <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="6" placeholder="Tell us about your team and how we can help." required></textarea>
        </div>
        <!-- Spam honeypot (Formspree) -->
        <div class="hp" aria-hidden="true">
          <label for="hp-field">Leave this field empty</label>
          <input id="hp-field" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn btn-primary btn-lg submit" type="submit">
          <span data-label>Send message</span> <Icon name="arrow-right" />
        </button>
        <p class="fine">By sending this form you agree to our <a href="/privacy">privacy policy</a>.</p>

        <div class="status" role="status" aria-live="polite" data-status hidden></div>
      </form>

      <aside class="info">
        <a class="info-card" href={`mailto:${site.email}`}>
          <span class="ic"><Icon name="mail" /></span>
          <div><strong>General & demos</strong><span>{site.email}</span></div>
        </a>
        <a class="info-card" href={`mailto:${site.supportEmail}`}>
          <span class="ic"><Icon name="life-buoy" /></span>
          <div><strong>Customer support</strong><span>{site.supportEmail}</span></div>
        </a>
        <div class="info-card static">
          <span class="ic"><Icon name="clock" /></span>
          <div><strong>Response time</strong><span>Usually within one business day</span></div>
        </div>
        <div class="info-card static">
          <span class="ic"><Icon name="shield-check" /></span>
          <div><strong>Your data is safe</strong><span>We only use your details to reply. See our <a href="/privacy">privacy policy</a>.</span></div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .body { padding-top: clamp(40px, 6vw, 64px); }
  .grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(28px, 5vw, 56px); align-items: start; }

  .form { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(22px, 4vw, 40px); box-shadow: var(--shadow-md); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { margin-bottom: 18px; }
  label { display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 7px; }
  label span { color: var(--brand-ink); }
  label .opt { color: var(--muted); font-weight: 400; }
  input, textarea {
    width: 100%; padding: 13px 15px; font: inherit; font-size: 1rem; color: var(--ink);
    background: var(--bg); border: 1px solid var(--border-strong); border-radius: 12px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea { resize: vertical; min-height: 140px; }
  input::placeholder, textarea::placeholder { color: color-mix(in srgb, var(--muted) 75%, transparent); }
  input:hover, textarea:hover { border-color: var(--muted); }
  input:focus, textarea:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 4px var(--brand-ring); }
  [aria-invalid='true'] { border-color: var(--p1); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .submit { width: 100%; margin-top: 4px; }
  .fine { margin-top: 14px; font-size: 0.84rem; color: var(--muted); text-align: center; }
  .fine a, .info a:not(.info-card) { color: var(--brand-ink); text-decoration: underline; text-underline-offset: 2px; }

  .status { display: flex; gap: 10px; align-items: flex-start; margin-top: 18px; padding: 14px 16px; border-radius: 12px; font-size: 0.94rem; font-weight: 500; }
  .status[hidden] { display: none; }
  .status.ok { background: var(--ok-bg); color: var(--ok); }
  .status.err { background: var(--p1-bg); color: var(--p1); }

  .info { display: grid; gap: 14px; }
  .info-card {
    display: flex; gap: 14px; align-items: flex-start; padding: 20px; border-radius: var(--radius);
    border: 1px solid var(--border); background: var(--card);
    transition: border-color 0.2s, transform 0.25s var(--ease), box-shadow 0.25s;
  }
  a.info-card:hover { border-color: var(--border-strong); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .info-card.static { background: transparent; }
  .ic { width: 42px; height: 42px; flex-shrink: 0; display: grid; place-items: center; border-radius: 12px; background: var(--brand-soft); color: var(--brand-ink); }
  .info-card strong { display: block; font-weight: 600; margin-bottom: 2px; }
  .info-card span { color: var(--muted); font-size: 0.93rem; overflow-wrap: anywhere; }

  @media (max-width: 880px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; gap: 0; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const label = button.querySelector<HTMLElement>('[data-label]')!;

  const show = (kind: 'ok' | 'err', msg: string) => {
    status.className = `status ${kind}`;
    status.textContent = msg;
    status.hidden = false;
  };

  form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((el) =>
    el.addEventListener('input', () => el.removeAttribute('aria-invalid')),
  );

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')].filter((el) => !el.checkValidity());
    invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
    if (invalid.length) {
      show('err', 'Please fill in your name, a valid email address and a message.');
      invalid[0].focus();
      return;
    }

    button.disabled = true;
    label.textContent = 'Sending…';
    status.hidden = true;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show('ok', 'Thanks — your message has been sent. We’ll be in touch soon.');
    } catch {
      show('err', 'Sorry, something went wrong. Please try again or email us directly.');
    } finally {
      button.disabled = false;
      label.textContent = 'Send message';
    }
  });
</script>
