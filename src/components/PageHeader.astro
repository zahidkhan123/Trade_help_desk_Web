---
interface Props { eyebrow?: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<header class="page-header">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    position: relative; overflow: hidden;
    padding-block: clamp(48px, 8vw, 88px) clamp(36px, 6vw, 56px);
    background:
      radial-gradient(600px 300px at 85% -10%, color-mix(in srgb, var(--brand) 16%, transparent), transparent 70%),
      var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }
  h1 { font-size: clamp(2.1rem, 5vw, 3.3rem); letter-spacing: -0.035em; margin-block: 14px 12px; }
  p { color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.15rem); max-width: 620px; }
</style>
