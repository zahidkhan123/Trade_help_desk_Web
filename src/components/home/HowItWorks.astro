---
import Icon from '../Icon.astro';

const steps = [
  { icon: 'wrench', title: 'Capture the job', text: 'Create work orders with photos, priorities and full details in seconds.' },
  { icon: 'file-text', title: 'Quote & schedule', text: 'Send professional quotes and convert them straight into invoices.' },
  { icon: 'check-circle', title: 'Get paid', text: 'Track everything against properties and clients until payment is complete.' },
] as const;
---
<section class="section section-soft" id="how-it-works">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow">How it works</span>
      <h2>A simple flow from request to payment</h2>
      <p>Three steps. One place. No spreadsheets or scattered emails.</p>
    </div>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step" data-reveal style={`--d: ${i * 90}ms`}>
          <div class="marker">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="ic"><Icon name={s.icon} size={22} /></span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; position: relative; }
  .steps::before {
    content: ''; position: absolute; top: 32px; left: calc(16.66% + 32px); right: calc(16.66% + 32px);
    border-top: 2px dashed var(--border-strong);
  }
  .step { text-align: center; padding-inline: 12px; position: relative; }
  .marker { position: relative; width: 64px; height: 64px; margin: 0 auto 22px; }
  .ic {
    width: 64px; height: 64px; display: grid; place-items: center; border-radius: 20px;
    background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow-md); color: var(--brand-ink);
    transition: transform 0.35s var(--ease);
  }
  .step:hover .ic { transform: translateY(-4px) rotate(-3deg); }
  .num {
    position: absolute; top: -8px; right: -12px; z-index: 1;
    font-family: var(--font-display); font-size: 0.72rem; font-weight: 700;
    padding: 3px 7px; border-radius: 999px; background: var(--brand); color: var(--on-brand);
  }
  .step h3 { font-size: 1.22rem; margin-bottom: 8px; }
  .step p { color: var(--muted); font-size: 0.96rem; max-width: 300px; margin-inline: auto; }

  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps::before { top: 32px; bottom: 32px; left: 31px; right: auto; border-top: 0; border-left: 2px dashed var(--border-strong); }
    .step { display: grid; grid-template-columns: 64px 1fr; column-gap: 20px; text-align: left; padding: 0 0 32px; }
    .step:last-child { padding-bottom: 0; }
    .marker { grid-row: span 2; margin: 0; }
    .step h3 { align-self: end; margin-top: 6px; }
    .step p { margin: 0; max-width: none; }
  }
</style>
